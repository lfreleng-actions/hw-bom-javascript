# The supply-chain cooldown lives in .github/dependabot.yml, not here. An
# npm min-release-age gate would also block Dependabot's security updates.

# Enforce the engines field in package.json.
engine-strict=true

# Pin all new installs to exact versions (no ^ or ~ written to package.json).
save-exact=true

# Run security audit on every install.
audit=true

# Suppress funding messages.
fund=false
